# ---------------------------------------------------------------
# Samz Fitness Hub — environment variables
# Copy this file to `.env.local` (already gitignored) and fill in
# the real values for local development. For production, add the
# same variables in Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------

# Gemini API key — powers the AI Plan Builder. Get from
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Resend API key — sends lead notification emails to the gym owner.
# Sign up at https://resend.com and create a key.
RESEND_API_KEY=

# Sender for lead emails. Must be a verified address in Resend.
# Format: "Display Name <email@yourdomain.com>"
RESEND_FROM_EMAIL=Samz Fitness Hub <leads@samzfitnesshub.com>

# Primary inbox that receives lead notifications.
LEAD_NOTIFY_EMAIL=fitnesshub.slg2@gmail.com

# Optional CC list (comma-separated). Leave empty to disable.
LEAD_NOTIFY_CC=rishavkumarkarn3@gmail.com,feelfree2query@gmail.com

# Google Apps Script Web App URL — appends each lead to the Sheet.
# Deploy the script from /docs/apps-script.gs as a Web App
# (execute as you, access: Anyone) and paste the URL here.
SHEETS_WEBHOOK_URL=

# Microsoft Clarity project ID — session recording + heatmaps.
# Get from https://clarity.microsoft.com → Settings → Setup.
# NEXT_PUBLIC_ prefix is required because the client component
# initialises Clarity in the browser.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
